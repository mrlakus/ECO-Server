{
  "name": "three-sisters-online",
  "version": "3.5.0",
  "private": true,
  "description": "Онлайн-версия настольной игры «Три сестры» для 2–4 игроков",
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/client/main.ts --bundle --outfile=public/app.js --target=es2020 --minify",
    "build": "npm run build:client",
    "start": "npm run build && tsx src/server/index.ts",
    "dev": "concurrently -k -n server,client -c blue,green \"tsx watch src/server/index.ts\" \"esbuild src/client/main.ts --bundle --outfile=public/app.js --target=es2020 --watch\"",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "versions": "git log --reverse --format=\"%h  %ad  %s\" --date=format:\"%d.%m %H:%M\"",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "build:prod": "npm run build:client && npm run build:server",
    "start:prod": "node dist/server.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^10.0.7",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
